# Copy to .env and fill in. Never commit .env.

# https://home.openweathermap.org/api_keys (free tier is enough)
OPENWEATHER_API_KEY=

# https://web.plant.id/ (used for leaf disease detection)
PLANT_ID_API_KEY=

# Any long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional overrides
# MODEL_PATH=models/crop_model.joblib
# INFO_DATABASE_URL=sqlite:///data/info.db
# DISCUSSIONS_DATABASE_URL=sqlite:///data/discussions.db
# FLASK_DEBUG=1
